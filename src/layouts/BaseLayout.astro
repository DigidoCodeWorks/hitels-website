---
import { sanityClient } from 'sanity:client';
import '../styles/global.css';
import { asset } from '../lib/cdn';
import { siteSettingsQuery } from '../sanity/queries';
import HelpWidget from '../components/shared/HelpWidget.astro';

// Cloudflare Web Analytics — no cookies, so no consent banner needed. Empty
// by default (schema-validated in astro.config.mjs) so local/preview builds
// don't send real traffic to the production analytics account; set once the
// beacon token exists (Cloudflare dashboard → Analytics → Web Analytics →
// add site → copy the token).
const CF_BEACON_TOKEN = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

// Google Tag Manager — same empty-by-default reasoning as CF_BEACON_TOKEN
// above: local/preview builds shouldn't fire real tags/conversions.
const GTM_ID = import.meta.env.PUBLIC_GTM_ID;

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  lang?: string;
  hreflangAlternates?: { lang: string; href: string }[];
}

// Site-wide singleton (see src/sanity/schemaTypes/siteSettings.ts) — sources
// the Organization JSON-LD and the OG image fallback below. title/description
// stay required props (not sourced here) so every existing call site keeps
// working unchanged; a page opts into the site default by passing its own
// resolved `page.seo?.title ?? siteSettings.defaultSeoTitle`, not by this
// layout reaching for it implicitly.
const siteSettings = await sanityClient.fetch(siteSettingsQuery, { language: Astro.currentLocale ?? 'en' });

const {
  title,
  description,
  ogImage = siteSettings?.defaultOgImage ?? asset('images/home/hero/mockup-desktop.webp'),
  ogType = 'website',
  noindex = false,
  lang = 'en',
  hreflangAlternates,
} = Astro.props;

const siteName = siteSettings?.siteName ?? 'Hitels';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: siteSettings?.organizationName ?? 'Hitels',
	url: Astro.site?.toString(),
	logo: siteSettings?.organizationLogoUrl ?? asset('images/home/footer/hitels-logo.svg'),
};
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{hreflangAlternates?.map(({ lang: altLang, href }) => (
			<link rel="alternate" hreflang={altLang} href={new URL(href, Astro.site)} />
		))}
		{/* x-default points at this page's own English version (site default
		    locale), not always the homepage — every page has an English
		    sibling, so this should never fall back to "/". */}
		{hreflangAlternates && (
			<link
				rel="alternate"
				hreflang="x-default"
				href={new URL(hreflangAlternates.find((a) => a.lang === 'en')?.href ?? '/', Astro.site)}
			/>
		)}

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />

		{CF_BEACON_TOKEN && (
			<script
				defer
				src="https://static.cloudflareinsights.com/beacon.min.js"
				data-cf-beacon={`{"token": "${CF_BEACON_TOKEN}"}`}
				is:inline
			/>
		)}

		{GTM_ID && (
			<script is:inline define:vars={{ GTM_ID }}>
				(function (w, d, s, l, i) {
					w[l] = w[l] || [];
					w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
					const f = d.getElementsByTagName(s)[0],
						j = d.createElement(s),
						dl = l != 'dataLayer' ? '&l=' + l : '';
					j.async = true;
					j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
					f.parentNode.insertBefore(j, f);
				})(window, document, 'script', 'dataLayer', GTM_ID);
			</script>
		)}

		<slot name="head" />
	</head>
	<body class="bg-background">
		{GTM_ID && (
			<noscript>
				<iframe
					src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
					height="0"
					width="0"
					style="display:none;visibility:hidden"
				></iframe>
			</noscript>
		)}
		<slot />
		<HelpWidget />
		<script>
			// Sitewide scroll reveal: fades/rises any [data-reveal] element into place
			// the first time it enters the viewport, then stops watching it (a
			// one-time entrance, not a repeating scroll effect). Lives in the layout
			// every page renders — it used to live in Footer.astro on the assumption
			// every page includes that component, which turned out to be false
			// (404.astro doesn't render a Footer), silently leaving that page's
			// data-reveal content stuck at its pre-reveal opacity forever.
			const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');

			if (revealEls.length && 'IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-revealed');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.15, rootMargin: '0px 0px -80px 0px' }
				);
				revealEls.forEach((el) => observer.observe(el));
			} else {
				revealEls.forEach((el) => el.classList.add('is-revealed'));
			}
		</script>
		<script>
			// Below-the-fold background videos (Footer, ProductOfferings) mark
			// themselves [data-lazy-video] and hold their real source(s) in
			// data-src instead of src/source[src], so preload="none" actually
			// keeps the browser from fetching them until they're about to be
			// visible — otherwise they compete for bandwidth with the Hero video
			// that's the page's actual LCP element on load (PageSpeed audit,
			// 2026-09-25: these were 1.9MB+686KB+201KB of eager network weight).
			const lazyVideos = document.querySelectorAll<HTMLVideoElement>('[data-lazy-video]');

			function loadLazyVideo(video: HTMLVideoElement) {
				if (video.dataset.src) {
					video.src = video.dataset.src;
				}
				video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((source) => {
					source.src = source.dataset.src!;
				});
				video.load();
				video.play().catch(() => {});
			}

			if (lazyVideos.length && 'IntersectionObserver' in window) {
				const videoObserver = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								loadLazyVideo(entry.target as HTMLVideoElement);
								videoObserver.unobserve(entry.target);
							}
						});
					},
					{ rootMargin: '200px 0px' }
				);
				lazyVideos.forEach((video) => videoObserver.observe(video));
			} else {
				lazyVideos.forEach((video) => loadLazyVideo(video));
			}
		</script>
	</body>
</html>
