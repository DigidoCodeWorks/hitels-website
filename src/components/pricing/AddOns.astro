---
import { sanityClient } from 'sanity:client';
import { asset } from '../../lib/cdn';
import { addOnsQuery } from '../../sanity/queries';

// Self-fetches the shared "Add-Ons" singleton (src/sanity/schemaTypes/
// addOns.ts) rather than a hardcoded array — same content Home's
// AddOns.astro renders in its own (mobile) layout.
const addOnsDoc = await sanityClient.fetch(addOnsQuery, { language: Astro.currentLocale ?? 'en' });
const ADDONS = addOnsDoc?.addons ?? [];
---

<section class="max-md:hidden flex flex-col gap-12 items-center px-[100px] max-lg:px-10 py-16 max-lg:py-14 relative w-full max-w-[1440px] mx-auto bg-background">
  <div data-reveal class="flex flex-col gap-4 items-center text-center w-[792px] max-w-full">
    <h2 class="font-heading text-h3 text-navy w-full">Optional add-ons</h2>
    <p class="font-body font-normal text-body-md text-gray w-full">Extend your services with these optional add-ons.</p>
  </div>

  <div class="flex gap-8 items-stretch max-lg:flex-col w-full">
    {ADDONS.map((addon, i) => (
      <div data-reveal style={`--reveal-delay: ${i * 120}ms`} class="bg-light-gray flex flex-1 flex-col gap-10 items-start p-8 max-md:p-6 rounded-2xl">
        <div class="flex flex-col gap-6 items-start w-full">
          <div class="flex flex-col gap-4 items-start w-full">
            <div class="flex items-start justify-between w-full">
              <h3 class="font-heading text-h5 text-navy whitespace-nowrap">{addon.title}</h3>
              <div class="flex items-center justify-center rounded-full size-8 bg-navy shrink-0">
                <img loading="lazy" src={addon.iconUrl} alt="" class="size-5" />
              </div>
            </div>
            <p class="font-body font-normal text-body-md text-gray w-full">{addon.description}</p>
          </div>
          <div class="flex gap-1 items-end w-full">
            <p class="font-heading text-[1.75rem] leading-[1.4] tracking-[-0.025em] text-navy whitespace-nowrap">{addon.price}</p>
            <p class="font-body font-normal text-body-md text-gray">/ month</p>
          </div>
          <div class="flex flex-col gap-4 items-start w-full">
            {(addon.features ?? []).map((feature) => (
              <div class="flex gap-2 items-start w-full">
                <img loading="lazy" src={asset('images/home/pricing/icon-check-dark.svg')} alt="" class="size-5 shrink-0" />
                <p class="flex-1 font-body font-normal text-body-md text-navy">{feature}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
