---
import Navigation from '../Navigation';
import Button from '../shared/Button.astro';
import { asset } from '../../lib/cdn';

interface Props {
  headline: string;
  subheading: string;
  primaryButtonLabel?: string;
  primaryButtonHref?: string;
  secondaryButtonLabel?: string;
  secondaryButtonHref?: string;
  imageUrl: string;
  imageAlt?: string;
}

const {
  headline,
  subheading,
  primaryButtonLabel = 'Book a demo',
  primaryButtonHref = '/contact-us',
  secondaryButtonLabel = 'Contact us',
  secondaryButtonHref = '/contact-us',
  imageUrl,
  imageAlt = '',
} = Astro.props;
---

<div data-hero class="flex flex-col items-center overflow-hidden relative w-full bg-gradient-to-b from-[#992d6f] via-[#ff4aa8] via-50% to-background">
  <div aria-hidden class="absolute inset-0 mix-blend-overlay opacity-40 bg-top-left pointer-events-none" style={`background-image: url('${asset('images/home/hero/hero-bg-texture.webp')}'); background-size: 1920px 1080px;`}></div>
  <div aria-hidden class="absolute flex items-center justify-center h-[100vh] left-[-323px] top-[366px] w-[150vw] pointer-events-none">
    <img src={asset('images/booking-engine/hero/decorative-blob.svg')} alt="" class="h-full w-full block object-fill" />
  </div>

  <Navigation client:load />

  <div class="flex gap-16 items-center justify-between px-[100px] max-lg:flex-col max-lg:gap-12 max-lg:px-10 max-md:px-4 py-[90px] max-lg:py-16 max-md:py-12 relative w-full max-w-[1440px]">
    <div class="flex flex-col gap-8 items-start relative w-[604px] max-w-full">
      <div data-reveal class="flex flex-col gap-4 items-start text-background w-full">
        <h1 class="font-heading text-h1 max-md:text-h3 w-full">{headline}</h1>
        <p class="font-body font-normal text-body-lg max-md:text-body-md w-full">
          {subheading}
        </p>
      </div>
      <div data-reveal style="--reveal-delay: 150ms" class="flex gap-4 items-start justify-center max-md:w-full">
        <Button href={primaryButtonHref} label={primaryButtonLabel} icon="calendar" variant="primary" padding="px-4 py-3" class="max-md:flex-1" />
        <Button href={secondaryButtonHref} label={secondaryButtonLabel} icon="chat" variant="secondary" padding="pl-4 pr-5 py-3 max-md:pl-3" class="max-md:flex-1" />
      </div>
    </div>

    <div data-reveal="fade" style="--reveal-delay: 250ms" class="h-[578px] max-lg:h-[420px] max-md:h-[320px] w-[498px] max-lg:w-full relative rounded-2xl shrink-0 overflow-hidden">
      <img
        src={imageUrl}
        alt={imageAlt}
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>
  </div>
</div>
