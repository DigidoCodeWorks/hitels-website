---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../Navigation';
import PostGrid from './PostGrid.astro';
import Footer from '../shared/Footer.astro';
import { breadcrumbSchema } from '../../lib/schema';

// Shared by both src/pages/discover.astro (English) and
// src/pages/is/discover.astro (Icelandic) — same extraction pattern as
// src/components/home/HomePage.astro. English copy for now (title/
// description/breadcrumb/heading); UI-chrome translation is a later pass.
const language = Astro.currentLocale ?? 'en';

const breadcrumbs = breadcrumbSchema([
	{ name: 'Home', url: new URL('/', Astro.site).toString() },
	{ name: 'Blog', url: new URL(Astro.url.pathname, Astro.site).toString() },
]);

const hreflangAlternates = [
  { lang: 'en', href: '/discover' },
  { lang: 'is', href: '/is/discover' },
];
---

<BaseLayout
	title="Resources — Hitels"
	description="Guides, news, and insights on direct bookings, hotel websites, and revenue growth from the Hitels team."
	lang={language}
	hreflangAlternates={hreflangAlternates}
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} is:inline />
	</Fragment>
	<header>
		<Navigation client:load variant="light" />
	</header>
	<main>
		<PostGrid />
	</main>
	<Footer />
</BaseLayout>
