---
// Inline (see IconCalendar.astro for why) -- ProductOfferings' CTA buttons
// swap text-background/text-navy on hover, so the arrow needs to follow via
// stroke="currentColor" the same way the label text does.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg class={className} viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <path d="M2.5 8H13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M9 3.5L13.5 8L9 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
</svg>
