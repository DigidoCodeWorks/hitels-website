---
interface Props {
  label: string;
  heading: string;
  description: string;
  /** A resolved image URL (R2 or otherwise) — callers resolve their own asset() paths, this component doesn't. */
  image: string;
  imageAlt: string;
  imageFirst?: boolean;
  imageBg?: string;
  /** CSS object-position for the plain-<img> case — lets a caller keep a
   * specific region of a source photo in frame when object-cover's default
   * center crop cuts off the part that matters at a given box size. */
  imageObjectPosition?: string;
  variant?: 'booking-engine' | 'custom-website';
}

const {
  heading,
  description,
  image,
  imageAlt,
  imageFirst = false,
  imageBg = '',
  imageObjectPosition = 'center',
  variant = 'booking-engine',
} = Astro.props;

// The two pages this component serves diverge in 3 coupled ways (section
// padding/gap/justify-center, image-wrapper height breakpoints, and content
// column width strategy) -- kept as one variant switch rather than
// independent props since picking one always implies the other two.
const VARIANT_STYLES = {
  'booking-engine': {
    section: 'flex gap-[138px] items-center justify-center px-[100px] py-[112px] max-lg:flex-col max-lg:gap-8 max-lg:px-10 max-lg:py-14 max-md:px-4 max-md:py-16 relative w-full max-w-[1440px] mx-auto bg-background',
    imageWrapper: 'h-[520px] max-lg:h-[392px] max-md:h-[260px] w-[604px] max-lg:w-full relative rounded-2xl shrink-0 overflow-hidden',
    content: 'flex flex-col gap-8 items-start w-[498px] max-lg:w-full shrink-0',
  },
  'custom-website': {
    section: 'flex items-center gap-[138px] max-lg:flex-col max-lg:gap-12 max-md:gap-8 px-[100px] py-[100px] max-lg:px-10 max-lg:py-10 max-md:px-4 max-md:py-10 relative w-full max-w-[1440px] mx-auto bg-background',
    imageWrapper: 'h-[520px] max-lg:h-[464px] max-md:h-[380px] w-[604px] max-lg:w-full relative rounded-2xl shrink-0 overflow-hidden',
    content: 'flex flex-1 flex-col gap-8 items-start w-full',
  },
};

const styles = VARIANT_STYLES[variant];

// DOM order is always [image, content] for both variants, so the asset is
// always on top once Tablet/Mobile collapses the row to a column
// (max-lg:flex-col) -- desktop-only left/right alternation instead comes
// from flex-row-reverse, which has no effect once the row direction becomes
// a column, so it never disturbs the mobile stacking order.
const sectionClass = !imageFirst ? `${styles.section} flex-row-reverse` : styles.section;
---

{/* Some features' media is a bespoke interactive component (a before/after
    slider, an animated chart, etc.) rather than a plain static photo — the
    default slot, when provided by the caller, replaces the <img> entirely
    while this component still owns the surrounding layout/reveal chrome. */}
<section class={sectionClass}>
  <div data-reveal="fade" class={`${styles.imageWrapper} ${imageBg}`}>
    {Astro.slots.has('default') ? <slot /> : <img loading="lazy" src={image} alt={imageAlt} class="absolute inset-0 w-full h-full object-cover" style={`object-position: ${imageObjectPosition}`} />}
  </div>
  <div data-reveal style="--reveal-delay: 120ms" class={styles.content}>
    <div class="flex flex-col gap-6 items-start w-full">
      <h2 class="font-heading text-h3 max-md:text-h5 text-navy w-full">{heading}</h2>
    </div>
    <p class="font-body font-normal text-body-md text-gray w-full">{description}</p>
  </div>
</section>
