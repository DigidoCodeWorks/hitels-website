---
import { sanityClient } from 'sanity:client';
import { asset } from '../../lib/cdn';
import Button from './Button.astro';
import { footerSettingsQuery, siteSettingsQuery } from '../../sanity/queries';
import { getStrings } from '../../i18n/strings';

const t = getStrings(Astro.currentLocale);

// Footer link columns ("Product" / "Company") are the same on every
// breakpoint. The Figma mobile spec originally had a different, larger set
// of links here (an extra "Resources" column, several placeholder "#"
// links) — dropped per 2026-08-28 request as outdated; mobile now just
// reuses the desktop link set.
//
// Content (CTA copy, contact info, link columns, social hrefs, copyright)
// comes from the footerSettings singleton — see its schema for what's
// deliberately excluded (logo, "by Revera" credit, decorative video/blob,
// Cookie Settings/Privacy Policy links) and why.
const language = Astro.currentLocale ?? 'en';
const footer = await sanityClient.fetch(footerSettingsQuery, { language });
if (!footer) {
  throw new Error(`Missing "footerSettings" document (language "${language}") in Sanity — run scripts/seed-footer-settings.mjs.`);
}

const siteSettings = await sanityClient.fetch(siteSettingsQuery, { language });
---

<footer class="flex flex-col gap-16 max-lg:gap-14 max-md:gap-8 items-center overflow-hidden pt-[416px] max-lg:pt-60 max-md:pt-40 pb-12 px-[100px] max-lg:px-10 max-md:px-4 relative w-full bg-navy">
  <div aria-hidden class="absolute inset-0 pointer-events-none">
    {/* Same animated-gradient-video treatment as Hero, using the user-supplied
        copy_of_hitels_20_gradient_light.mp4 (inverted direction: light top ->
        deep purple bottom, matching this section's look vs. Hero's dark-to-light). */}
    <video
      muted
      loop
      playsinline
      preload="none"
      poster={asset('images/home/footer/footer-gradient-video-poster.webp')}
      class="absolute inset-0 w-full h-full object-cover"
      data-lazy-video
    >
      <source data-src={asset('images/home/footer/footer-gradient-video.webm')} type="video/webm" />
      <source data-src={asset('images/home/footer/footer-gradient-video.mp4')} type="video/mp4" />
    </video>
    <div
      class="hidden max-lg:block absolute inset-0 mix-blend-overlay opacity-0 bg-top-left"
      style={`background-image: url('${asset('images/home/hero/hero-bg-texture.webp')}'); background-size: 1920px 1080px;`}
    ></div>
    {/* Mirrors the Hero's bottom fade: on wide/large-desktop viewports object-cover
        scales the video up to cover the full width, which crops out the start of its
        own fade from the page background into purple, leaving a hard edge at the top
        of the footer. This overlay guarantees a soft transition regardless of crop. */}
    <div class="absolute inset-x-0 top-0 h-1/3 bg-gradient-to-b from-background to-transparent max-lg:hidden"></div>
  </div>
  <div
    aria-hidden
    class="absolute flex h-[55.56vh] max-lg:h-[44.44vh] items-center justify-center left-1/2 -translate-x-1/2 top-[-250px] max-lg:top-[-180px] w-[111.11vw] max-lg:w-[83.33vw] pointer-events-none rotate-180"
  >
    <img src={asset('images/home/footer/decorative-blob.svg')} alt="" loading="lazy" class="h-full w-full" />
  </div>

  <div class="flex flex-col gap-10 items-center px-[212px] max-lg:px-0 relative w-full max-w-[1016px]">
    <div class="flex flex-col gap-6 items-center text-center text-background w-full">
      <h2 data-reveal class="font-heading text-h2 max-md:text-h4 w-full">{footer.ctaHeadline}</h2>
      <p data-reveal style="--reveal-delay: 100ms" class="font-body font-normal text-body-lg w-full">
        {footer.ctaBody}
      </p>
    </div>
    <div class="flex gap-4 items-start justify-center">
      <Button href={footer.primaryButtonHref} label={footer.primaryButtonLabel} icon="calendar" variant="primary" />
      <Button href={footer.secondaryButtonHref} label={footer.secondaryButtonLabel} icon="chat" variant="secondary" />
    </div>
  </div>

  <div class="flex flex-col gap-[72px] max-lg:gap-14 max-md:gap-8 items-start relative w-full max-w-[1440px] mx-auto">
    <div class="flex flex-col gap-5 items-start w-full">
      <div class="flex flex-col gap-0.5 items-end w-[111px]">
        <img src={asset('images/home/footer/hitels-logo.svg')} alt={siteSettings?.organizationName ?? 'Hitels'} loading="lazy" class="w-full aspect-[113/30.91]" />
        <div class="flex gap-1 items-center">
          <span class="font-body text-background text-[0.53125rem]">{t.footer.by}</span>
          <img src={asset('images/home/footer/by-revera.svg')} alt="Revera" loading="lazy" class="h-[7.8px]" />
        </div>
      </div>

      <div class="flex gap-8 items-start w-full max-lg:flex-col">
        <div class="flex flex-col justify-between items-start self-stretch shrink-0 w-[604px] max-lg:w-full">
          <p class="font-heading text-h6 text-background w-full">{footer.contactHeadline}</p>
          <div class="flex flex-col gap-3 items-start w-full">
            <a href={footer.phoneHref ?? '#'} class="flex gap-3 items-center w-full text-background hover:underline">
              <img src={asset('images/home/footer/icon-phone.svg')} alt="" loading="lazy" class="size-5" />
              <p class="flex-1 font-body font-normal text-body-md">{footer.phoneLabel}</p>
            </a>
            <a href={footer.mailingListHref ?? '#'} class="flex gap-3 items-center w-full text-background hover:underline">
              <img src={asset('images/home/footer/icon-envelope.svg')} alt="" loading="lazy" class="size-5" />
              <p class="flex-1 font-body font-normal text-body-md">{footer.mailingListLabel}</p>
            </a>
          </div>
        </div>

        <!-- Same Product + Company columns on every breakpoint (mobile previously had
             its own extra "Resources" column and several placeholder "#" links — that
             was the outdated Figma mobile spec; simplified to match desktop). -->
        <div class="flex flex-1 gap-8 items-start md:items-end">
          <div class="flex flex-1 flex-col gap-4 items-start text-background">
            <p class="font-body font-medium text-body-md w-full">{t.footer.product}</p>
            <div class="flex flex-col gap-3 items-start font-body font-normal text-body-md w-full">
              {footer.productLinks.map((link) => (
                <a href={link.href} class="w-full hover:underline">{link.label}</a>
              ))}
            </div>
          </div>
          <div class="flex flex-1 flex-col gap-4 items-start text-background">
            <p class="font-body font-medium text-body-md w-full">{t.footer.company}</p>
            <div class="flex flex-col gap-3 items-start font-body font-normal text-body-md w-full">
              {footer.companyLinks.map((link) => (
                <a href={link.href} class="w-full hover:underline">{link.label}</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-between max-lg:flex-col max-lg:gap-8 max-lg:items-start w-full">
      <div class="flex gap-6 items-center shrink-0">
        {/* "#" is treated the same as blank/missing — the Sanity field currently
            holds "#" as a placeholder rather than being left empty, and a link to
            "#" is a dead link, not a real profile. Hide in both cases until a real
            URL is set (per the field's own Studio description: "Leave blank to
            hide the icon."). */}
        {footer.instagramHref && footer.instagramHref !== '#' && (
          <a href={footer.instagramHref} aria-label="Instagram"><img src={asset('images/home/footer/icon-instagram.svg')} alt="" loading="lazy" class="size-6" /></a>
        )}
        {footer.facebookHref && footer.facebookHref !== '#' && (
          <a href={footer.facebookHref} aria-label="Facebook"><img src={asset('images/home/footer/icon-facebook.svg')} alt="" loading="lazy" class="size-[22px]" /></a>
        )}
        {footer.linkedinHref && footer.linkedinHref !== '#' && (
          <a href={footer.linkedinHref} aria-label="LinkedIn"><img src={asset('images/home/footer/icon-linkedin.svg')} alt="" loading="lazy" class="size-6" /></a>
        )}
      </div>
      <div class="flex items-center justify-between max-lg:flex-wrap gap-4 font-body font-normal text-body-md text-background w-[604px] max-lg:w-full whitespace-nowrap">
        <p>{footer.copyrightText}</p>
        <a href={t.footer.cookieSettingsHref} class="hover:underline">{t.footer.cookieSettingsLabel}</a>
        <a href={t.footer.privacyPolicyHref} class="hover:underline">{t.footer.privacyPolicyLabel}</a>
      </div>
    </div>
  </div>
</footer>
