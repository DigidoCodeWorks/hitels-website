---
import IconCalendar from '../icons/IconCalendar.astro';
import IconChat from '../icons/IconChat.astro';
import IconTag from '../icons/IconTag.astro';

// Inline components, not R2-hosted asset() URLs like most icons in this
// project: this button's variants change text color on hover
// (VARIANT_STYLES below), and an <img src="..."> reference to an SVG is
// opaque to CSS — it can't follow that color change the way an inline
// <svg stroke="currentColor"> can. See src/components/icons/ for why each
// one is inlined instead of just this file.
const ICONS = {
  calendar: IconCalendar,
  chat: IconChat,
  tag: IconTag,
};

interface Props {
  href: string;
  label: string;
  icon?: keyof typeof ICONS;
  variant: 'primary' | 'secondary' | 'dark';
  padding?: string;
  gap?: string;
  iconSize?: string;
  textSize?: string;
  class?: string;
}

const {
  href,
  label,
  icon,
  variant,
  padding = 'pl-4 pr-5 py-3',
  gap = 'gap-3',
  iconSize = 'size-5',
  textSize = 'text-body-md',
  class: className = '',
} = Astro.props;

const VARIANT_STYLES = {
  primary: 'bg-yellow text-navy hover:bg-brand hover:text-background',
  secondary: 'bg-background text-navy hover:bg-navy hover:text-background',
  dark: 'bg-navy text-background hover:bg-background hover:text-navy hover:border-navy',
};

const Icon = icon ? ICONS[icon] : null;
---

<a
  href={href}
  class={`${VARIANT_STYLES[variant]} flex ${gap} items-center justify-center rounded-lg border-2 border-transparent transition-colors duration-300 ${padding} ${className}`}
>
  {Icon && <Icon class={iconSize} />}
  <span class={`font-body font-medium ${textSize} whitespace-nowrap`}>{label}</span>
</a>
