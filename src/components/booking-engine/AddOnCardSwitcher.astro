---
// Illustrative example of a guest-facing add-on picker inside someone else's
// booking flow — fixed, non-editable content (a guest-facing hotel example,
// not a real Hitels product), same reasoning as Home's Benefits.astro/
// PartnerLogos.astro staying out of the page builder. Auto-cycles which card
// sits on top of the stack, matching the Figma "switching card" spec.
const ADDONS = [
  { title: 'Spa access', price: '5.500 kr.', imageUrl: 'https://pub-cc3bba3bab304bebb22958edffa16e9c.r2.dev/images/booking-engine/features/addon-spa.webp' },
  { title: 'Massage', price: '17.990 kr.', imageUrl: 'https://pub-cc3bba3bab304bebb22958edffa16e9c.r2.dev/images/booking-engine/features/addon-massage.webp' },
  { title: 'Champagne bottle', price: '15.000 kr.', imageUrl: 'https://pub-cc3bba3bab304bebb22958edffa16e9c.r2.dev/images/booking-engine/features/addon-champagne.webp' },
];
---

<div class="absolute inset-0 size-full flex items-center justify-center bg-light-gray">
  <div class="relative w-[420px] max-w-[85%] h-[92px] max-md:h-20" data-addon-switcher>
    {ADDONS.map((addon, i) => (
      <div
        class="addon-card absolute inset-x-0 top-0 flex items-stretch h-[92px] max-md:h-20 rounded-[20px] border border-border overflow-hidden bg-background shadow-sm transition-transform duration-700 ease-out"
        data-addon-card
        data-index={i}
      >
        <div class="size-[92px] max-md:size-20 shrink-0">
          <img src={addon.imageUrl} alt="" loading="lazy" class="size-full object-cover" />
        </div>
        <div class="flex-1 flex items-center justify-between gap-4 max-md:gap-2 px-5 max-md:px-3">
          <div class="flex flex-col gap-2 min-w-0">
            <p class="font-heading text-h6 text-navy truncate">{addon.title}</p>
            <p class="font-body font-normal text-body-sm text-gray">{addon.price}</p>
          </div>
          <span class="shrink-0 rounded-xl bg-light-gray px-4 py-2 max-md:px-2.5 max-md:py-1.5 font-body font-semibold text-body-sm text-navy whitespace-nowrap">Add add-on</span>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-addon-switcher]').forEach((root) => {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-addon-card]'));
    const total = cards.length;
    let front = 0;

    function layout() {
      cards.forEach((card, i) => {
        const rel = (i - front + total) % total;
        card.style.zIndex = String(total - rel);
        card.style.transform = `translateY(${rel * 14}px) scale(${1 - rel * 0.05})`;
      });
    }
    layout();

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    setInterval(() => {
      front = (front + 1) % total;
      layout();
    }, 2600);
  });
</script>
