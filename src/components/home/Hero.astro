---
import Navigation from '../Navigation';
import Button from '../shared/Button.astro';
import HeroStories from './HeroStories.astro';
import { asset } from '../../lib/cdn';

interface Props {
  headline: string;
  subheadingDesktop: string;
  subheadingMobile: string;
  primaryButtonLabel?: string;
  primaryButtonHref?: string;
  secondaryButtonLabel?: string;
  secondaryButtonHref?: string;
  altHref?: string;
}

const {
  headline,
  subheadingDesktop,
  subheadingMobile,
  primaryButtonLabel = 'Book a demo',
  primaryButtonHref = '/contact-us',
  secondaryButtonLabel = 'Contact us',
  secondaryButtonHref = '/contact-us',
  altHref,
} = Astro.props;
---

<div data-hero class="flex flex-col gap-[72px] max-lg:gap-12 h-[85vh] min-h-[700px] max-h-[900px] max-lg:h-auto max-lg:pb-12 items-center overflow-clip relative w-full bg-navy">
  <div aria-hidden class="absolute inset-0 pointer-events-none">
    {/* The background is an animated gradient video (navy->purple->white), not a static
        fill — the Figma export silently drops video fills to an empty node, which is why
        this was missed initially. Sourced from the team's asset upload, transcoded down
        from 4.6MB to 700KB (MP4) / 117KB (WebM), poster frame for the pre-load paint. */}
    <video
      autoplay
      muted
      loop
      playsinline
      poster={asset('images/home/hero/hero-gradient-video-poster.webp')}
      class="absolute inset-0 w-full h-full object-cover"
    >
      <source src={asset('images/home/hero/hero-gradient-video.webm')} type="video/webm" />
      <source src={asset('images/home/hero/hero-gradient-video.mp4')} type="video/mp4" />
    </video>
    <div
      class="absolute inset-0 mix-blend-overlay opacity-10 max-lg:opacity-40 bg-top-left"
      style={`background-image: url('${asset('images/home/hero/hero-bg-texture.webp')}'); background-size: 1920px 1080px;`}
    ></div>
    {/* The video's own baked-in fade to white is timed for its native aspect ratio —
        on wide/large-desktop viewports object-cover scales the video up to cover the
        full width, which crops out the tail end of that fade before it reaches white,
        leaving a hard edge. This overlay guarantees a soft fade into the next section
        regardless of how the video gets cropped. */}
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-b from-transparent to-background max-lg:hidden"></div>
  </div>

  <div
    aria-hidden
    class="absolute flex h-[100vh] items-center justify-center left-[-348.03px] top-[462.74px] w-[150vw] pointer-events-none"
  >
    <div class="rotate-[-4.09deg] h-full w-full">
      <img src={asset('images/home/hero/decorative-blob.svg')} alt="" class="h-full w-full block object-fill" />
    </div>
  </div>

  <Navigation client:load lang={Astro.currentLocale === 'is' ? 'is' : 'en'} altHref={altHref} />

  <HeroStories />

  <div class="flex items-center justify-between px-[100px] max-lg:flex-col max-lg:px-10 max-md:px-4 max-lg:text-center relative w-full max-w-[1440px] mx-auto">
    <div class="flex flex-col gap-8 items-start max-lg:items-center w-[604px] max-lg:w-full mr-[-16px] max-lg:mr-0">
      <div data-reveal class="flex flex-col gap-4 items-center text-background w-full">
        <h1 class="font-heading text-h1 max-md:text-h3 w-full">{headline}</h1>
        {/* Desktop/Tablet use the full copy; Mobile uses shorter copy — confirmed
            distinct wording per breakpoint in the source, not a truncation */}
        <p class="hidden max-md:block font-body font-normal text-body-lg w-full">
          {subheadingMobile}
        </p>
        <p class="max-md:hidden font-body font-normal text-body-lg w-full">
          {subheadingDesktop}
        </p>
      </div>
      <div data-reveal style="--reveal-delay: 150ms" class="flex gap-4 items-start justify-center max-md:w-full">
        <Button href={primaryButtonHref} label={primaryButtonLabel} icon="calendar" variant="primary" padding="px-4 py-3" class="max-md:flex-1" />
        <Button href={secondaryButtonHref} label={secondaryButtonLabel} icon="chat" variant="secondary" padding="pl-4 pr-5 py-3 max-md:pl-3" class="max-md:flex-1" />
      </div>
    </div>

    <div data-reveal="fade" style="--reveal-delay: 250ms" class="h-[598px] w-[652px] max-lg:h-[451px] max-lg:w-[464px] max-md:h-[327px] max-md:w-full relative">
      <div class="absolute inset-0 max-lg:left-0 max-lg:w-full overflow-hidden pointer-events-none">
        {/* Both source images are self-contained device mockups (transparent
            background, full bezel baked in) — plain object-cover fills this
            wrapper directly, same fix as mockup-phone.webp below. Previously
            used an oversized-image + negative-percentage-offset trick tuned
            to zoom past a differently-composed source's padding; swapping in
            today's new mockup renders without matching those percentages is
            what caused the mis-cropped/overflowing render this replaced. */}
        <picture>
          <source media="(max-width: 767px)" srcset={asset('images/home/hero/mockup-desktop-mobile.webp')} />
          <img
            src={asset('images/home/hero/mockup-desktop.webp')}
            alt="Hitels booking engine shown on desktop"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </picture>
      </div>
      <div class="absolute h-[292px] w-[152px] left-[497px] top-[306px] max-lg:h-[210px] max-lg:w-[100px] max-lg:left-[362px] max-lg:top-[241px] max-md:h-[160px] max-md:w-[96px] max-md:left-[269px] max-md:top-[159px] overflow-hidden pointer-events-none">
        {/* mockup-phone.webp is a pre-cropped screenshot of the phone mockup's
            own small Figma frame (already showing the correct bezel, not the
            full uncropped device) — plain object-cover fills this wrapper
            directly. Previously used the same oversized-image + percentage-
            offset trick as the desktop mockup below, tuned for a different,
            differently-shaped source image; swapping in a new source without
            matching percentages is what caused the mis-cropped/distorted
            render this replaced. */}
        <img
          src={asset('images/home/hero/mockup-phone.webp')}
          alt="Hitels booking engine shown on mobile"
          class="absolute inset-0 w-full h-full object-cover"
        />
      </div>
    </div>
  </div>
</div>
