---
interface Card {
  logoUrl: string;
  imageUrl: string;
  caption: string;
  href: string;
}

interface Props {
  cards: Card[];
}

const { cards } = Astro.props;

// Equal-width fill cards (no horizontal scroll): each card grows on hover
// and its siblings shrink to make room, since flex-grow only controls how
// leftover space is distributed among items sharing the same flex-basis.
---

<section class="flex flex-col gap-16 max-lg:gap-14 max-md:gap-8 items-start px-[100px] py-[112px] max-lg:px-10 max-lg:py-14 max-md:px-4 max-md:py-16 relative w-full max-w-[1440px] mx-auto bg-background">
  <div data-reveal class="flex flex-col gap-6 items-center text-center w-full">
    <p class="font-body font-normal text-body-md text-gray w-full">Customer stories</p>
    <h2 class="font-heading text-h3 text-navy w-full">Proven to increase direct revenue</h2>
  </div>

  <div class="flex gap-8 max-md:gap-4 items-stretch max-md:flex-col w-full">
    {cards.map((card, i) => (
      <a
        href={card.href}
        target="_blank"
        rel="noopener noreferrer"
        data-reveal
        class="story-card flex flex-col gap-4 items-start justify-center min-w-0 flex-1 max-md:flex-none md:hover:grow-[2]"
        style={`--reveal-delay: ${i * 120}ms`}
      >
        <div class="flex flex-col h-[440px] max-lg:h-[440px] max-md:h-80 items-start p-8 max-md:p-6 relative rounded-2xl shrink-0 w-full overflow-hidden">
          <img loading="lazy" src={card.imageUrl} alt="" class="absolute inset-0 w-full h-full object-cover" />
          <img loading="lazy" src={card.logoUrl} alt="" height="20" class="relative h-5 max-w-full" />
        </div>
        <p class="font-body font-normal text-body-md text-navy w-full md:truncate">{card.caption}</p>
      </a>
    ))}
  </div>
</section>

<style>
  /*
   * Combined here (rather than Tailwind utility classes) because the
   * sitewide [data-reveal] rule in global.css sets the `transition`
   * shorthand, which would otherwise silently reset transition-property
   * to just opacity/transform and kill the flex-grow hover animation.
   */
  .story-card {
    transition:
      flex-grow 0.5s ease-out,
      opacity 1s cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
      transform 1s cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .story-card {
      transition: flex-grow 0.5s ease-out;
    }
  }
</style>
