---
import { asset } from '../../lib/cdn';

interface Offering {
  eyebrow: string;
  headline: string;
  body: string;
  ctaLabel?: string;
  ctaHref?: string;
  desktopImageUrl: string;
  mobileImageUrl: string;
}

interface Props {
  offerings: Offering[];
}

const { offerings } = Astro.props;

// Alternating background behind each offering's image — a visual/design
// choice, not content, so it's derived from array position rather than
// stored as an editable field.
const IMAGE_BG = ['bg-light-gray', 'bg-navy'];

// desktopImageUrl/mobileImageUrl accept either an image or a short looping
// video (e.g. the Custom Website offering's collage was replaced with a
// 15s video loop) — same R2-hosted-URL field, no separate schema field for
// video, so this just switches on the file extension to decide which tag
// to render. Video plays autoplay/muted/loop/playsinline so it behaves like
// a background — no controls, no sound, matching what a static image did.
const VIDEO_EXTENSIONS = ['.mp4', '.webm', '.mov', '.ogv'];
function isVideoUrl(url: string) {
  const path = url.split('?')[0].toLowerCase();
  return VIDEO_EXTENSIONS.some((ext) => path.endsWith(ext));
}
---

<section class="flex flex-col gap-8 items-start px-[100px] py-[112px] max-lg:px-10 max-lg:py-14 max-lg:gap-14 max-md:px-4 max-md:py-16 max-md:gap-8 relative w-full max-w-[1440px] mx-auto bg-background">
  <div data-reveal class="flex flex-col gap-6 items-center text-center w-full">
    <h2 class="font-heading text-h3 text-navy w-full">Everything you need to scale direct revenue</h2>
    <p class="font-body font-normal text-body-md text-gray w-full">We don't just give you the tools; we build the engine for you.</p>
  </div>

  <div class="flex gap-8 items-center max-md:flex-col w-full">
    {offerings.map((offering, i) => (
      <div data-reveal style={`--reveal-delay: ${i * 120}ms`} class="group flex flex-1 flex-col gap-8 items-start rounded-2xl w-full">
        <div class={`${IMAGE_BG[i % IMAGE_BG.length]} h-[360px] max-lg:h-[280px] overflow-clip relative rounded-2xl shrink-0 w-full`}>
          {isVideoUrl(offering.desktopImageUrl) ? (
            <video
              src={offering.desktopImageUrl}
              autoplay
              muted
              loop
              playsinline
              class="block max-md:hidden absolute inset-0 max-w-none object-cover pointer-events-none size-full transition-transform duration-300 ease-out group-hover:scale-105"
            />
          ) : (
            <img
              src={offering.desktopImageUrl}
              alt=""
              class="block max-md:hidden absolute inset-0 max-w-none object-cover pointer-events-none size-full transition-transform duration-300 ease-out group-hover:scale-105"
            />
          )}
          {isVideoUrl(offering.mobileImageUrl) ? (
            <video
              src={offering.mobileImageUrl}
              autoplay
              muted
              loop
              playsinline
              class="hidden max-md:block absolute inset-0 max-w-none object-cover pointer-events-none size-full transition-transform duration-300 ease-out group-hover:scale-105"
            />
          ) : (
            <img
              src={offering.mobileImageUrl}
              alt=""
              class="hidden max-md:block absolute inset-0 max-w-none object-cover pointer-events-none size-full transition-transform duration-300 ease-out group-hover:scale-105"
            />
          )}
        </div>
        <div class="flex flex-col gap-6 items-start w-full">
          <div class="flex flex-col gap-4 items-start w-full">
            <div class="flex flex-col gap-3 items-start w-full">
              <p class="font-body font-normal text-body-md text-gray w-full">{offering.eyebrow}</p>
              <p class="font-heading text-h5 text-navy w-full">{offering.headline}</p>
            </div>
            <p class="font-body font-normal text-body-md text-gray w-full">{offering.body}</p>
          </div>
          <a
            href={offering.ctaHref}
            class="bg-navy text-background hover:bg-background hover:text-navy flex gap-2 items-center justify-center rounded border-2 border-transparent hover:border-navy transition-colors duration-300 px-3 py-2"
          >
            <span class="font-body font-medium text-body-sm whitespace-nowrap">{offering.ctaLabel}</span>
            <img src={asset('images/home/product-offerings/icon-arrow-right.svg')} alt="" class="size-4" />
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
