---
import { sanityClient } from 'sanity:client';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import FeatureSection from '../shared/FeatureSection.astro';
import TypewriterHeadings from './TypewriterHeadings.astro';
import ChatFeedAnimation from './ChatFeedAnimation.astro';
import Pricing from '../shared/Pricing.astro';
import Footer from '../shared/Footer.astro';
import { pageBySlugQuery, siteSettingsQuery } from '../../sanity/queries';
import type { PageBySlugQueryResult } from '../../../sanity.types';
import { breadcrumbSchema } from '../../lib/schema';
import { getStrings } from '../../i18n/strings';

// Shared by both src/pages/custom-hotels-website.astro (English) and
// src/pages/is/sersnidinn-vefur.astro (Icelandic) — same extraction
// pattern as src/components/home/HomePage.astro.
type Section = NonNullable<PageBySlugQueryResult>['sections'][number];

const language = Astro.currentLocale ?? 'en';

const page = await sanityClient.fetch(pageBySlugQuery, { slug: 'custom-hotels-website', language });

if (!page) {
  throw new Error(`Missing "page" document with slug "custom-hotels-website" and language "${language}" in Sanity — run scripts/seed-custom-website-page.mjs.`);
}

const heroSection = page.sections.find((s): s is Extract<Section, { _type: 'productHeroSection' }> => s._type === 'productHeroSection');
if (!heroSection) {
  throw new Error('Custom Website page document has no productHeroSection — Hero requires one.');
}

const featuresSection = page.sections.find((s): s is Extract<Section, { _type: 'featuresSection' }> => s._type === 'featuresSection');

const siteSettings = await sanityClient.fetch(siteSettingsQuery, { language });

const seoTitle = page.seo?.title ?? siteSettings?.defaultSeoTitle ?? 'Custom Website Design — Hitels';
const seoDescription =
  page.seo?.description ??
  siteSettings?.defaultSeoDescription ??
  'We design and build award-winning hotel websites from scratch. No templates — just bespoke, data-driven design engineered to bypass OTAs and capture direct bookings.';
const seoOgImage = page.seo?.ogImage ?? siteSettings?.defaultOgImage;

// Service schema — see booking-engine's page component for why `offers`
// links out to /pricing/ instead of embedding a numeric price directly.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Custom hotel website design',
  name: heroSection.headline,
  description: seoDescription,
  provider: { '@type': 'Organization', name: siteSettings?.organizationName ?? 'Hitels' },
  areaServed: 'Worldwide',
  offers: { '@type': 'Offer', url: new URL('/pricing/', Astro.site).toString() },
};

const t = getStrings(Astro.currentLocale);
const breadcrumbs = breadcrumbSchema([
	{ name: t.breadcrumbs.home, url: new URL(Astro.currentLocale === 'is' ? '/is/' : '/', Astro.site).toString() },
	{ name: t.breadcrumbs.customWebsite, url: new URL(Astro.url.pathname, Astro.site).toString() },
]);

const hreflangAlternates = [
  { lang: 'en', href: '/custom-hotels-website' },
  { lang: 'is', href: '/is/sersnidinn-vefur' },
];
const altHref = hreflangAlternates.find((a) => a.lang !== language)?.href;
---

<BaseLayout title={seoTitle} description={seoDescription} ogImage={seoOgImage} lang={language} hreflangAlternates={hreflangAlternates}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} is:inline />
	</Fragment>
	<header>
		<Hero
			headline={heroSection.headline}
			subheading={heroSection.subheading}
			primaryButtonLabel={heroSection.primaryButtonLabel ?? undefined}
			primaryButtonHref={heroSection.primaryButtonHref ?? undefined}
			secondaryButtonLabel={heroSection.secondaryButtonLabel ?? undefined}
			secondaryButtonHref={heroSection.secondaryButtonHref ?? undefined}
			altHref={altHref}
		/>
	</header>
	<main>
		{featuresSection?.features.map((feature) => {
			const props = {
				label: feature.label,
				heading: feature.heading,
				description: feature.description,
				image: feature.imageUrl,
				imageAlt: feature.imageAlt ?? '',
				imageFirst: feature.imageFirst,
				imageBg: feature.imageHasLightBackground ? 'bg-light-gray' : undefined,
				variant: 'custom-website' as const,
			};

			if (feature._key === 'design') {
				return (
					<FeatureSection {...props}>
						<TypewriterHeadings />
					</FeatureSection>
				);
			}

			if (feature._key === 'partnership') {
				return (
					<FeatureSection {...props}>
						<ChatFeedAnimation />
					</FeatureSection>
				);
			}

			// feature-visual-storytelling.webp's "Offers: Midweek Escape" promo
			// card sits low in the source photo — object-cover's default center
			// crop pushes it out of frame in the mobile box's shorter aspect
			// ratio, leaving mostly blank space above it.
			if (feature._key === 'experience') {
				return <FeatureSection {...props} imageObjectPosition="bottom" />;
			}

			return <FeatureSection {...props} />;
		})}
		<Pricing />
	</main>
	<Footer />
</BaseLayout>
