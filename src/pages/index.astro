---
import { sanityClient } from 'sanity:client';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import PartnerLogos from '../components/home/PartnerLogos.astro';
import ProductOfferings from '../components/home/ProductOfferings.astro';
import Testimonial from '../components/home/Testimonial.astro';
import Stories from '../components/home/Stories.astro';
import Benefits from '../components/home/Benefits.astro';
import Pricing from '../components/shared/Pricing.astro';
import AddOns from '../components/home/AddOns.astro';
import Faq from '../components/home/Faq.astro';
import Footer from '../components/shared/Footer.astro';
import { homePageQuery, siteSettingsQuery } from '../sanity/queries';
import type { HomePageQueryResult } from '../../sanity.types';

// Home is the first page converted to the Sanity page-builder pattern (see
// src/sanity/schemaTypes/page.ts). Benefits, Pricing, PartnerLogos, and
// Footer stay as fixed, directly-imported sections — not page-builder
// content — see the plan's "explicitly out of scope" notes: PartnerLogos has
// too much bespoke per-logo sizing to genericize safely, Benefits has heavy
// bespoke interactivity tightly coupled to its exact 3-card layout, and
// Pricing/Footer are global/shared across pages, not Home-specific content.
type Section = NonNullable<HomePageQueryResult>['sections'][number];

const page = await sanityClient.fetch(homePageQuery);

if (!page) {
  throw new Error('Missing "page" document with slug "home" in Sanity — run scripts/seed-home-page.mjs.');
}

const heroSection = page.sections.find((s): s is Extract<Section, { _type: 'heroSection' }> => s._type === 'heroSection');
if (!heroSection) {
  throw new Error('Home page document has no heroSection — Hero requires one.');
}

// Site Settings singleton provides the SEO fallback when this page's own
// `seo` object (Studio-editable per-document override) doesn't set a field.
const siteSettings = await sanityClient.fetch(siteSettingsQuery);

const seoTitle = page.seo?.title ?? siteSettings?.defaultSeoTitle ?? 'Hitels — Turn website visitors into direct bookings';
const seoDescription =
  page.seo?.description ??
  siteSettings?.defaultSeoDescription ??
  'We build award-winning, bespoke hotel websites and seamless booking engines. No templates, no DIY builders — just a premium digital presence done for you from start to finish.';
const seoOgImage = page.seo?.ogImage ?? siteSettings?.defaultOgImage;
---

<BaseLayout title={seoTitle} description={seoDescription} ogImage={seoOgImage}>
	<header>
		<Hero
			headline={heroSection.headline}
			subheadingDesktop={heroSection.subheadingDesktop}
			subheadingMobile={heroSection.subheadingMobile}
			primaryButtonLabel={heroSection.primaryButtonLabel ?? undefined}
			primaryButtonHref={heroSection.primaryButtonHref ?? undefined}
			secondaryButtonLabel={heroSection.secondaryButtonLabel ?? undefined}
			secondaryButtonHref={heroSection.secondaryButtonHref ?? undefined}
		/>
	</header>
	<main>
		<PartnerLogos />
		{page.sections.map((section) => {
			switch (section._type) {
				case 'productOfferingsSection':
					return <ProductOfferings offerings={section.offerings} />;
				case 'testimonialsSection':
					return <Testimonial />;
				case 'customerStoriesSection':
					return <Stories cards={section.cards} />;
				default:
					return null;
			}
		})}
		{/* Benefits/Pricing are fixed, not page-builder content (see the top-of-file
		    note), but they sit in the *middle* of the original section order — between
		    Stories and AddOns/Faq — so the dynamic loop is split around them rather
		    than dumping both fixed sections after every dynamic one. */}
		<Benefits />
		<Pricing />
		{page.sections.map((section) => {
			switch (section._type) {
				case 'addOnsSection':
					return <AddOns addons={section.addons} />;
				case 'faqSection':
					return <Faq />;
				default:
					return null;
			}
		})}
	</main>
	<Footer />
</BaseLayout>
