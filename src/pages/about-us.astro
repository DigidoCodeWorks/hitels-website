---
import { sanityClient } from 'sanity:client';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/about/Hero.astro';
import WhoWeAre from '../components/about/WhoWeAre.astro';
import Team from '../components/about/Team.astro';
import Beliefs from '../components/about/Beliefs.astro';
import WhatIsHitels from '../components/about/WhatIsHitels.astro';
import Pricing from '../components/shared/Pricing.astro';
import Footer from '../components/shared/Footer.astro';
import { pageBySlugQuery, siteSettingsQuery } from '../sanity/queries';
import type { PageBySlugQueryResult } from '../../sanity.types';
import { breadcrumbSchema } from '../lib/schema';

// Fifth page converted to the Sanity page-builder pattern. Reuses
// productHeroSection (this page's Hero has the same headline/subheading/
// two-CTA shape as Custom Website/Booking Engine, plus its own single photo
// via that type's optional image fields). Pricing/Footer stay fixed, same
// reasoning as every other converted page.
type Section = NonNullable<PageBySlugQueryResult>['sections'][number];

const page = await sanityClient.fetch(pageBySlugQuery, { slug: 'about-us' });

if (!page) {
  throw new Error('Missing "page" document with slug "about-us" in Sanity — run scripts/seed-about-us-page.mjs.');
}

const heroSection = page.sections.find((s): s is Extract<Section, { _type: 'productHeroSection' }> => s._type === 'productHeroSection');
if (!heroSection || !heroSection.imageUrl) {
  throw new Error('About Us page document has no productHeroSection (with an image) — Hero requires one.');
}

const whoWeAreSection = page.sections.find((s): s is Extract<Section, { _type: 'statsIntroSection' }> => s._type === 'statsIntroSection');
const teamSection = page.sections.find((s): s is Extract<Section, { _type: 'teamSection' }> => s._type === 'teamSection');
const beliefsSection = page.sections.find((s): s is Extract<Section, { _type: 'beliefsSection' }> => s._type === 'beliefsSection');
const whatIsHitelsSection = page.sections.find((s): s is Extract<Section, { _type: 'whatIsHitelsSection' }> => s._type === 'whatIsHitelsSection');

const siteSettings = await sanityClient.fetch(siteSettingsQuery);

const seoTitle = page.seo?.title ?? siteSettings?.defaultSeoTitle ?? 'About Us — Hitels';
const seoDescription =
  page.seo?.description ??
  siteSettings?.defaultSeoDescription ??
  'Hitels is a specialized digital agency and software provider on a mission to help hoteliers take back control of their revenue, their online presence, and their guest relationships.';
const seoOgImage = page.seo?.ogImage ?? siteSettings?.defaultOgImage;

const breadcrumbs = breadcrumbSchema([
	{ name: 'Home', url: new URL('/', Astro.site).toString() },
	{ name: 'About Us', url: new URL(Astro.url.pathname, Astro.site).toString() },
]);
---

<BaseLayout title={seoTitle} description={seoDescription} ogImage={seoOgImage}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} is:inline />
	</Fragment>
	<header>
		<Hero
			headline={heroSection.headline}
			subheading={heroSection.subheading}
			primaryButtonLabel={heroSection.primaryButtonLabel ?? undefined}
			primaryButtonHref={heroSection.primaryButtonHref ?? undefined}
			secondaryButtonLabel={heroSection.secondaryButtonLabel ?? undefined}
			secondaryButtonHref={heroSection.secondaryButtonHref ?? undefined}
			imageUrl={heroSection.imageUrl}
			imageAlt={heroSection.imageAlt ?? undefined}
		/>
	</header>
	<main>
		{whoWeAreSection && <WhoWeAre headline={whoWeAreSection.headline} body={whoWeAreSection.body} stats={whoWeAreSection.stats} />}
		{teamSection && <Team headline={teamSection.headline} body={teamSection.body} members={teamSection.members} />}
		{beliefsSection && <Beliefs headline={beliefsSection.headline} beliefs={beliefsSection.beliefs} />}
		{whatIsHitelsSection && <WhatIsHitels headline={whatIsHitelsSection.headline} body={whatIsHitelsSection.body} features={whatIsHitelsSection.features} />}
		<Pricing />
	</main>
	<Footer />
</BaseLayout>
