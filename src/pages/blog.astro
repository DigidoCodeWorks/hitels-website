---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation';
import PostGrid from '../components/blog/PostGrid.astro';
import Footer from '../components/shared/Footer.astro';
import { breadcrumbSchema } from '../lib/schema';

const breadcrumbs = breadcrumbSchema([
	{ name: 'Home', url: new URL('/', Astro.site).toString() },
	{ name: 'Blog', url: new URL(Astro.url.pathname, Astro.site).toString() },
]);
---

<BaseLayout
	title="Resources — Hitels"
	description="Guides, news, and insights on direct bookings, hotel websites, and revenue growth from the Hitels team."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} is:inline />
	</Fragment>
	<header>
		<Navigation client:load variant="light" />
	</header>
	<main>
		<PostGrid />
	</main>
	<Footer />
</BaseLayout>
