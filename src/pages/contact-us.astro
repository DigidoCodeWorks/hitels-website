---
import { sanityClient } from 'sanity:client';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/contact/Hero.astro';
import ContactForm from '../components/contact/ContactForm';
import Footer from '../components/shared/Footer.astro';
import { pageBySlugQuery, siteSettingsQuery } from '../sanity/queries';
import type { PageBySlugQueryResult } from '../../sanity.types';
import { breadcrumbSchema } from '../lib/schema';

// Fourth page converted to the Sanity page-builder pattern. Reuses
// simpleHeroSection (headline + subheading only — this page's Hero has no
// buttons or image). ContactForm has no CMS content of its own; Footer
// stays fixed, same reasoning as every other converted page.
type Section = NonNullable<PageBySlugQueryResult>['sections'][number];

const page = await sanityClient.fetch(pageBySlugQuery, { slug: 'contact-us' });

if (!page) {
  throw new Error('Missing "page" document with slug "contact-us" in Sanity — run scripts/seed-contact-us-page.mjs.');
}

const heroSection = page.sections.find((s): s is Extract<Section, { _type: 'simpleHeroSection' }> => s._type === 'simpleHeroSection');
if (!heroSection) {
  throw new Error('Contact Us page document has no simpleHeroSection — Hero requires one.');
}

const siteSettings = await sanityClient.fetch(siteSettingsQuery);

const seoTitle = page.seo?.title ?? siteSettings?.defaultSeoTitle ?? 'Contact us — Hitels';
const seoDescription =
  page.seo?.description ??
  siteSettings?.defaultSeoDescription ??
  "Get in touch with Hitels. We'll get to know your team's needs and see how our hotel website and booking engine products fit, with expert advice from our consultants.";
const seoOgImage = page.seo?.ogImage ?? siteSettings?.defaultOgImage;

const breadcrumbs = breadcrumbSchema([
	{ name: 'Home', url: new URL('/', Astro.site).toString() },
	{ name: 'Contact Us', url: new URL(Astro.url.pathname, Astro.site).toString() },
]);
---

<BaseLayout title={seoTitle} description={seoDescription} ogImage={seoOgImage}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} is:inline />
	</Fragment>
	<header>
		<Hero headline={heroSection.headline} subheading={heroSection.subheading} />
	</header>
	<main>
		<ContactForm client:load />
	</main>
	<Footer />
</BaseLayout>
